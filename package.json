{
  "name": "dsh-driftglass",
  "description": "Deep-sea glass theme for DSH 0.2.2-rc.1 desktop and web",
  "version": "1.5.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realhenrylan/DSH-Transparent-UI-Plugin.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown && tsc --noEmit false --emitDeclarationOnly --declaration --outDir lib/types",
    "lint": "tsc --noEmit",
    "test": "node --test tests/package.test.mjs && vitest run tests/appearance.test.tsx tests/desktop-background.test.ts tests/plugin-page.test.ts tests/theme-layer.test.ts tests/wallpaper-selection.test.tsx tests/windows-sidebar-chrome.test.ts"
  },
  "license": "AGPL-3.0-only",
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.2-rc.1",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.19.2",
    "@types/react": "18.3.24",
    "@types/wicg-file-system-access": "2023.10.7",
    "jsdom": "26.1.0",
    "lightningcss": "1.30.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ]
}
